NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/rhythm

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your_cookie_secret_change_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# CORS
CLIENT_URL=http://localhost:5173

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Jamendo API (music provider)
JAMENDO_CLIENT_ID=your_jamendo_client_id

# YouTube Data API v3 (music provider)
YOUTUBE_API_KEY=your_youtube_api_key
