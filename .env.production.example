# ==========================================
# RHYTHM PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Server
NODE_ENV=production
PORT=5000

# Database & Caching
MONGO_URI=mongodb://mongo:27017/rhythm
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Security
JWT_ACCESS_SECRET=replace_with_a_secure_random_32_character_string_minimum
JWT_REFRESH_SECRET=replace_with_another_secure_random_32_character_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Cookies
CORS_ORIGIN=https://yourdomain.com,http://localhost
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true

# Jamendo Royalty-Free Music API (Optional - S3/seed fallback active)
JAMENDO_CLIENT_ID=

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
